# Supabase Configuration (Required for backend integration)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Nomor WhatsApp admin CookPlan untuk fitur pesan/belanja
# Format internasional tanpa + atau 0 di depan (mis. 085167542103 -> 6285167542103)
VITE_WA_ADMIN_NUMBER=6285167542103

# PostHog Analytics (Optional - dapatkan API key gratis di https://us.posthog.com)
VITE_POSTHOG_KEY=phc_your_project_api_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Third-party APIs (Optional/Future features)
# VITE_MAPS_API_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_SERVER_KEY=

